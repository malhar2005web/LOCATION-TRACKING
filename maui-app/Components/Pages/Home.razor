@page "/"
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<!-- ============================================ -->
    <!-- VIEW: Splash / Loading Screen                -->
    <!-- ============================================ -->
    <div id="splash-view" class="view active">
        <div class="splash-container">
            <div class="splash-logo-wrapper">
                <img src="img/skyway-logo.png" class="splash-icon" alt="Skyway Logo">
                <div class="splash-pulse-ring"></div>
                <div class="splash-pulse-ring delay-1"></div>
                <div class="splash-pulse-ring delay-2"></div>
            </div>
            <h1 class="splash-title">Location Tracker</h1>
            <p class="splash-subtitle">Real-time GPS Monitoring</p>
            <div class="splash-loader">
                <div class="splash-loader-bar"></div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- VIEW: Login Screen (Role Selection)          -->
    <!-- ============================================ -->
    <div id="login-view" class="view">
        <div class="login-container">
            <!-- Decorative background -->
            <!-- Clean background, no decorative elements -->

            <div class="login-content">
                <div class="login-header">
                    <div class="login-logo">
                        <img src="img/skyway-logo.png" alt="Skyway Logo" style="height: 80px; object-fit: contain;">
                    </div>
                    <h1 class="login-title">Location Tracker</h1>
                    <p class="login-subtitle-text">Select your role to continue</p>
                </div>

                <!-- Role Selection Tabs -->
                <div class="role-tabs">
                    <button id="tab-client" class="role-tab active" onclick="switchLoginTab('client')">
                        <span class="tab-label">Client</span>
                    </button>
                    <button id="tab-admin" class="role-tab" onclick="switchLoginTab('admin')">
                        <span class="tab-label">Admin</span>
                    </button>
                    <div class="tab-indicator"></div>
                </div>

                <!-- Client Login Form -->
                <div id="client-login-form" class="login-form-section active">
                    <div class="form-card">
                        <div class="input-group">
                            <label class="input-label">Client ID</label>
                            <div class="input-wrapper">
                                <span class="input-icon">ID</span>
                                <input type="text" id="client-id-input" 
                                       placeholder="e.g. CLT-A1B2C3" 
                                       class="form-input" 
                                       autocomplete="off"
                                       autocapitalize="characters">
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="input-label">Device ID</label>
                            <div class="input-wrapper">
                                <span class="input-icon">DEV</span>
                                <input type="text" id="client-device-id-input" 
                                       placeholder="Auto-detected from device" 
                                       class="form-input">
                            </div>
                            <p class="input-hint">Automatically fetched from your device</p>
                        </div>

                        <button id="btn-client-login" class="primary-btn" onclick="handleClientLogin()">
                            <span class="btn-text">Login as Client</span>
                            <span class="btn-arrow">→</span>
                            <div class="btn-loader hidden"></div>
                        </button>

                        <div class="form-divider">
                            <span>New here?</span>
                        </div>

                        <button id="btn-goto-register" class="secondary-btn" onclick="showView('register-view')">
                            <span class="btn-text">Register New Client</span>
                        </button>
                    </div>
                </div>

                <!-- Admin Login Form -->
                <div id="admin-login-form" class="login-form-section">
                    <div class="form-card">
                        <div class="input-group">
                            <label class="input-label">Admin ID</label>
                            <div class="input-wrapper">
                                <span class="input-icon">ADM</span>
                                <input type="text" id="admin-id-input" 
                                       placeholder="Enter admin ID" 
                                       class="form-input" 
                                       autocomplete="off">
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="input-label">Password</label>
                            <div class="input-wrapper">
                                <span class="input-icon">PWD</span>
                                <input type="password" id="admin-password-input" 
                                       placeholder="Enter password" 
                                       class="form-input">
                                <button class="toggle-password" onclick="togglePassword('admin-password-input', this)">
                                    <span>VIEW</span>
                                </button>
                            </div>
                        </div>

                        <button id="btn-admin-login" class="primary-btn" onclick="handleAdminLogin()">
                            <span class="btn-text">Login as Admin</span>
                            <span class="btn-arrow">→</span>
                            <div class="btn-loader hidden"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- VIEW: Client Registration                    -->
    <!-- ============================================ -->
    <div id="register-view" class="view">
        <div class="page-container">
            <header class="page-header">
                <button class="back-btn" onclick="showView('login-view')">
                    <span>←</span>
                </button>
                <h2 class="page-title">Register Client</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="page-content">
                <div class="form-card">
                    <div class="register-icon-wrapper">
                        <div class="register-icon">NEW</div>
                    </div>
                    <h3 class="form-card-title">Create New Account</h3>
                    <p class="form-card-desc">Register your device to start location tracking</p>

                    <div class="input-group">
                        <label class="input-label">Your Name (Optional)</label>
                        <div class="input-wrapper">
                            <span class="input-icon">NAME</span>
                            <input type="text" id="reg-name-input" 
                                   placeholder="Enter your name" 
                                   class="form-input">
                        </div>
                    </div>

                    <div class="input-group">
                        <label class="input-label">Device ID</label>
                        <div class="input-wrapper">
                            <span class="input-icon">DEV</span>
                            <input type="text" id="reg-device-id-input" 
                                   placeholder="Auto-detected" 
                                   class="form-input">
                        </div>
                        <p class="input-hint">This is your unique device identifier</p>
                    </div>

                    <button id="btn-register" class="primary-btn" onclick="handleRegister()">
                        <span class="btn-text">Register & Get Client ID</span>
                        <span class="btn-arrow">→</span>
                        <div class="btn-loader hidden"></div>
                    </button>
                </div>

                <!-- Registration Success Card (hidden by default) -->
                <div id="register-success" class="success-card hidden">
                    <div class="success-icon">OK</div>
                    <h3 class="success-title">Registration Successful!</h3>
                    <div class="success-detail">
                        <span class="detail-label">Your Client ID</span>
                        <span id="generated-client-id" class="detail-value-large">CLT-XXXXXX</span>
                    </div>
                    <p class="success-hint">Save this ID. You'll need it to login.</p>
                    <button class="primary-btn" onclick="showView('login-view')">
                        <span class="btn-text">Go to Login</span>
                        <span class="btn-arrow">→</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- VIEW: Client Dashboard                       -->
    <!-- ============================================ -->
    <div id="client-view" class="view">
        <div class="dashboard-layout">
            <!-- Main Panel Content (Full Width, No Sidebar) -->
            <main class="main-panel">
                <!-- Dashboard Header -->
                <!-- Dashboard Header -->
                <header class="dashboard-header">
                    <div class="header-left-group">
                        <img src="img/skyway-logo.png" alt="Skyway Logo" style="height: 54px; margin-right: 14px; object-fit: contain;">
                        
                        <!-- Profile/Settings Dropdown wraps the orange avatar/icon -->
                        <div class="profile-dropdown-container">
                            <div class="client-avatar profile-dropdown-btn" onclick="toggleProfileDropdown()" style="cursor: pointer; display: flex; align-items: center; justify-content: center; background-color: var(--color-orange, #F28C52);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: white; margin: 0;">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div class="profile-dropdown-menu" id="profile-dropdown-menu">
                                <a href="#" onclick="event.preventDefault(); alert('My Profile');" class="dropdown-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    <span>My Profile</span>
                                </a>
                                <a href="#" onclick="event.preventDefault(); event.stopPropagation(); toggleThemeMode();" class="dropdown-item theme-toggle-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                    <span>Theme: <strong id="current-theme-label">Light</strong></span>
                                    <div class="switch-control">
                                        <div class="switch-handle"></div>
                                    </div>
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" onclick="event.preventDefault(); handleLogout();" class="dropdown-item logout-link" style="color: var(--color-red) !important;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    <span>Logout</span>
                                </a>
                            </div>
                        </div>
                        
                        <div class="header-user-info">
                            <div class="user-name-row">
                                <span class="user-name" id="client-welcome-name">demo admin2</span>
                                <div class="checked-in-pill">
                                    <span class="pill-dot" id="client-status-dot"></span>
                                    <span class="pill-text" id="client-status-indicator">Checked In</span>
                                </div>
                            </div>
                            <p class="employee-id" id="client-id-display">Employee ID: 11</p>
                        </div>
                    </div>
                </header>

                <!-- Page content container -->
                <div class="dashboard-content">
                    
                    <!-- Row 1: Welcome message and Stats Row -->
                    <div class="welcome-stats-row">
                        <!-- Welcome message card (Clickable to toggle stats) -->
                        <div class="welcome-msg-card collapsible-card" onclick="toggleClientStats(event)">
                            <div class="welcome-orb"></div>
                            <div class="welcome-msg-content" style="width: 100%; display: flex; flex-direction: column; margin-left: 0;">
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <div class="welcome-text-group">
                                        <span class="welcome-subtitle" id="client-welcome-greeting">Good Morning,</span>
                                        <h2 class="welcome-title"><span id="client-welcome-name-banner">demo admin2</span>,</h2>
                                        <p class="welcome-desc">Let's make today productive. <span class="stats-tap-hint" style="font-weight: 600; text-decoration: underline; color: var(--color-orange, #F28C52); margin-left: 4px;">(Tap to view stats)</span></p>
                                    </div>
                                    <div id="stats-toggle-arrow" class="stats-toggle-arrow-circle" style="transition: transform 0.3s ease; display: flex; align-items: center; justify-content: center; background: rgba(242, 140, 82, 0.15); color: #F28C52; border-radius: 50%; width: 36px; height: 36px; flex-shrink: 0; margin-left: 10px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </div>
                                </div>
                                
                                <!-- Collapsible stats container -->
                                <div id="client-stats-container" class="collapsible-stats-container" onclick="event.stopPropagation()">
                                    <div class="stat-bubbles-grid" style="margin-top: 20px; width: 100%;">
                                        <div class="stat-bubble-card">
                                            <div class="stat-icon-container" style="background: var(--color-green-bg); color: var(--color-green);">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                                            </div>
                                            <div class="stat-bubble-info">
                                                <span class="stat-number" id="stat-visits-count">0</span>
                                                <span class="stat-label">Total Visits <span class="stat-label-sub">Today</span></span>
                                            </div>
                                        </div>
                                        <div class="stat-bubble-card">
                                            <div class="stat-icon-container" style="background: var(--color-orange-bg); color: var(--color-orange);">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                            </div>
                                            <div class="stat-bubble-info">
                                                <span class="stat-number" id="stat-dsr-count">0</span>
                                                <span class="stat-label">DSR Updates <span class="stat-label-sub">Today</span></span>
                                            </div>
                                        </div>
                                        <div class="stat-bubble-card">
                                            <div class="stat-icon-container" style="background: var(--color-blue-bg); color: #8C9EFF;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                                            </div>
                                            <div class="stat-bubble-info">
                                                <span class="stat-number" id="stat-pending-tasks-count">0</span>
                                                <span class="stat-label">Pending Tasks <span class="stat-label-sub">Today</span></span>
                                            </div>
                                        </div>
                                        <div class="stat-bubble-card">
                                            <div class="stat-icon-container" style="background: var(--color-amber-bg); color: #D4B44A;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                            </div>
                                            <div class="stat-bubble-info">
                                                <span class="stat-number" id="stat-duration-count">00:00 <span class="stat-unit">hrs</span></span>
                                                <span class="stat-label">Work Duration <span class="stat-label-sub">Today</span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Action Cards Grid (6 cards) -->
                    <div class="dashboard-action-grid">
                        
                        <!-- Day Start / End Toggle Card -->
                        <div class="action-card-premium" id="card-day-start" onclick="handleDayToggle()">
                            <div class="card-premium-top">
                                <div class="card-premium-icon" id="day-toggle-icon-container" style="background: rgba(242, 140, 82, 0.15); color: #F28C52;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                </div>
                                <span class="card-premium-status-pill status-inactive" id="badge-day-start">Pending</span>
                            </div>
                            <div class="card-premium-bottom">
                                <div class="card-premium-text">
                                    <h3 class="card-premium-title" id="day-toggle-title">Day Start</h3>
                                    <p class="card-premium-desc" id="day-toggle-desc">Begin your workday and tracking</p>
                                </div>
                                <button class="card-premium-arrow-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Check In Card -->
                        <div class="action-card-premium" id="card-check-in" onclick="handleCheckIn()">
                            <div class="card-premium-top">
                                <div class="card-premium-icon" style="background: rgba(216, 204, 255, 0.45); color: #8A70FF;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                </div>
                                <span class="card-premium-status-pill status-inactive" id="badge-check-in">Pending</span>
                            </div>
                            <div class="card-premium-bottom">
                                <div class="card-premium-text">
                                    <h3 class="card-premium-title">Check In</h3>
                                    <p class="card-premium-desc">Mark daily branch attendance</p>
                                </div>
                                <button class="card-premium-arrow-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Leave Management Card -->
                        <div class="action-card-premium" id="card-leave-page" onclick="handleLeavePage()">
                            <div class="card-premium-top">
                                <div class="card-premium-icon" style="background: rgba(138, 191, 154, 0.15); color: #8ABF9A;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                </div>
                                <span class="card-premium-status-pill status-new">New</span>
                            </div>
                            <div class="card-premium-bottom">
                                <div class="card-premium-text">
                                    <h3 class="card-premium-title">Leave Management</h3>
                                    <p class="card-premium-desc">Apply for leave and check status</p>
                                </div>
                                <button class="card-premium-arrow-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Reports Card -->
                        <div class="action-card-premium" id="card-reports" onclick="handleReports()">
                            <div class="card-premium-top">
                                <div class="card-premium-icon" style="background: rgba(220, 238, 255, 0.5); color: #5B8CFF;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                                </div>
                            </div>
                            <div class="card-premium-bottom">
                                <div class="card-premium-text">
                                    <h3 class="card-premium-title">Reports</h3>
                                    <p class="card-premium-desc">View location history and logs</p>
                                </div>
                                <button class="card-premium-arrow-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Today's Reminders Card -->
                        <div class="action-card-premium reminders-highlight" id="card-reminders" onclick="handleReminders()">
                            <div class="card-premium-top">
                                <div class="card-premium-icon" style="background: rgba(244, 208, 111, 0.18); color: #E5C15F;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                                </div>
                                <span class="card-premium-counter" id="badge-reminders-count">0</span>
                            </div>
                            <div class="card-premium-bottom">
                                <div class="card-premium-text">
                                    <h3 class="card-premium-title" id="badge-reminders-title">Today's Reminders</h3>
                                    <p class="card-premium-desc" id="badge-reminders-desc">Check tasks and reminders</p>
                                </div>
                                <button class="card-premium-arrow-btn">
