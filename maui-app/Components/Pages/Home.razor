    <!-- VIEW: Leave Application Screen               -->
    <!-- ============================================ -->
    <div id="leave-application-view" class="view">
        <div class="page-container">
            <header class="page-header client-header submenu-header">
                <div class="header-left">
                    <button class="back-btn-header" onclick="goBackFromLeaveStatus()">
                        <span class="back-arrow">←</span> <span class="back-text">Back</span>
                    </button>
                    <div class="header-title-block">
                        <h2 class="page-title">Leave Management</h2>
                        <span class="submenu-client-name">Welcome Client</span>
                        <div class="client-status-pill-container" style="display: flex; align-items: center; gap: 6px; margin-top: 4px;">
                            <div class="status-dot active" id="leave-app-status-dot"></div>
                            <span id="leave-app-status-indicator">Online</span>
                        </div>
                    </div>
                </div>
                <div class="header-right">
                    <div class="company-logo-small">
                        <img src="img/skyway-logo.png" alt="Skyway Logo">
                    </div>
                </div>
            </header>

            <div class="page-content">
                <div class="glass-form-card" style="padding: 20px;">
                    <h3 class="form-title">LEAVE APPLICATION</h3>

                    <!-- Section 1: Leave Details -->
                    <div class="form-section-card" style="margin-bottom: 20px; padding: 16px; border-radius: 12px; background: var(--color-bg-tertiary); border: 1px solid var(--color-border);">
                        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--color-text-primary); font-size: 0.95rem; font-weight: 700; border-bottom: 1px solid #E0E0E0; padding-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                            <span>Leave</span> Leave Details
                        </h4>
                        <div class="input-group">
                            <label class="input-label">Leave Type <span style="color:#ef4444;">*</span></label>
                            <select id="leave-type" class="glass-select" onchange="calculateTotalLeaveDays()">
                                <option value="">Please Select</option>
                                <option value="Casual Leave">Casual Leave (CL)</option>
                                <option value="Sick Leave">Sick Leave (SL)</option>
                                <option value="Privilege Leave">Privilege Leave (PL)</option>
                                <option value="Leave Without Pay">Leave Without Pay (LWP)</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label class="input-label">Full/Half Day <span style="color:#ef4444;">*</span></label>
                            <select id="leave-full-half" class="glass-select" onchange="calculateTotalLeaveDays()">
                                <option value="">Please Select</option>
                                <option value="Full Day">Full Day</option>
                                <option value="Half Day">Half Day</option>
                            </select>
                        </div>
                    </div>

                    <!-- Section 2: Duration -->
                    <div class="form-section-card" style="margin-bottom: 20px; padding: 16px; border-radius: 12px; background: var(--color-bg-tertiary); border: 1px solid var(--color-border);">
                        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--color-text-primary); font-size: 0.95rem; font-weight: 700; border-bottom: 1px solid #E0E0E0; padding-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                            <span>Time</span> Duration
                        </h4>
                        <div class="input-group">
                            <label class="input-label">Leave Required From <span style="color:#ef4444;">*</span></label>
                            <input type="date" id="leave-from-date" class="glass-input" onchange="calculateTotalLeaveDays()">
                        </div>
                        <div class="input-group">
                            <label class="input-label">Leave Required Till <span style="color:#ef4444;">*</span></label>
                            <input type="date" id="leave-till-date" class="glass-input" onchange="calculateTotalLeaveDays()">
                        </div>
                        
                        <!-- Dynamic Calculation Display -->
                        <div class="calc-display-card" style="margin-top: 14px; padding: 10px 14px; background: rgba(46, 125, 50, 0.06); border: 1px dashed rgba(46, 125, 50, 0.25); border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-secondary);">Calculated Leave Required:</span>
                            <span id="leave-total-display" style="font-size: 1rem; font-weight: 700; color: #2E7D32;">0.0 Days</span>
                        </div>
                    </div>

                    <!-- Section 3: Reason -->
                    <div class="form-section-card" style="margin-bottom: 20px; padding: 16px; border-radius: 12px; background: var(--color-bg-tertiary); border: 1px solid var(--color-border);">
                        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--color-text-primary); font-size: 0.95rem; font-weight: 700; border-bottom: 1px solid #E0E0E0; padding-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                            <span>Reason</span> Reason
                        </h4>
                        <div class="input-group">
                            <label class="input-label">Reason for Leave <span style="color:#ef4444;">*</span></label>
                            <textarea id="leave-reason" class="glass-textarea" placeholder="Describe the reason for applying leave..." rows="4"></textarea>
                        </div>
                    </div>

                    <!-- Section 4: Delegation -->
                    <div class="form-section-card" style="margin-bottom: 20px; padding: 16px; border-radius: 12px; background: var(--color-bg-tertiary); border: 1px solid var(--color-border);">
                        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--color-text-primary); font-size: 0.95rem; font-weight: 700; border-bottom: 1px solid #E0E0E0; padding-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                            <span>Delegate</span> Delegation
                        </h4>
                        <div class="input-group">
                            <label class="input-label">In Absence Responsible Person <span style="color:#ef4444;">*</span></label>
                            <input type="text" id="leave-absence-person" class="glass-input" placeholder="Name of colleague handling duties">
                        </div>
                    </div>

                    <!-- Summary Card before submission -->
                    <div id="leave-summary-card" class="form-section-card hidden" style="margin-bottom: 24px; padding: 14px; border-radius: 12px; background: rgba(230, 126, 34, 0.06); border: 1px solid rgba(230, 126, 34, 0.2);">
                        <h4 style="margin-top: 0; margin-bottom: 8px; color: var(--color-text-primary); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase;">Leave Request Summary</h4>
                        <div style="font-size: 0.825rem; display: flex; flex-direction: column; gap: 4px;">
                            <div><strong style="color: var(--color-text-secondary);">Type:</strong> <span id="summary-leave-type">--</span></div>
                            <div><strong style="color: var(--color-text-secondary);">Duration:</strong> <span id="summary-leave-duration">--</span></div>
                            <div><strong style="color: var(--color-text-secondary);">Total Days:</strong> <span id="summary-leave-days">--</span></div>
                        </div>
                    </div>

                    <!-- Submit / Cancel Buttons -->
                    <div style="display: flex; gap: 12px;">
                        <button class="primary-btn" onclick="submitLeave()" style="flex: 2;">SUBMIT LEAVE REQUEST</button>
                        <button class="secondary-btn" onclick="showView('client-view')" style="flex: 1;">RETURN TO DASHBOARD</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

