                        <select id="leaves-filter-type" class="glass-select" style="flex: 1; min-width: 100px;" onchange="applyLeavesFilters()">
                            <option value="">All Types</option>
                            <option value="Casual Leave">Casual Leave</option>
                            <option value="Sick Leave">Sick Leave</option>
                            <option value="Privilege Leave">Privilege Leave</option>
                            <option value="Leave Without Pay">Leave Without Pay</option>
                        </select>

                        <select id="leaves-sort" class="glass-select" style="flex: 1; min-width: 100px;" onchange="applyLeavesFilters()">
                            <option value="newest">Newest First</option>
