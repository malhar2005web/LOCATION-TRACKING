--shared
--gc-sections
--export-dynamic
-z relro
-z noexecstack
-z max-page-size=16384
-z now
--enable-new-dtags
--build-id=sha1
--warn-shared-textrel
--fatal-warnings
--no-rosegment
--allow-shlib-undefined
-soname libxamarin-app.so
-m elf_i386
-z max-page-size=4096
-L "C:\Program Files\dotnet\packs\Microsoft.Android.Runtime.Mono.36.android-x86\36.1.43\runtimes\android-x86\native"
obj\Debug\net10.0-android\android\typemaps.x86.o
obj\Debug\net10.0-android\android\environment.x86.o
obj\Debug\net10.0-android\android\compressed_assemblies.x86.o
obj\Debug\net10.0-android\android\marshal_methods.x86.o
obj\Debug\net10.0-android\android\jni_remap.x86.o
-lc
